# =============================================================================
# DocMonAuto — Environment Variables Template
# Copy this file to .env and fill in values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_PORT=3001
APP_SECRET=change-me-32-chars-minimum-here!
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DocMonAuto

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://docmonauto:password@localhost:5432/docmonauto
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=docmonauto
DATABASE_USER=docmonauto
DATABASE_PASSWORD=change-me-db-password

# -----------------------------------------------------------------------------
# Redis (메시지 큐, 캐시)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_AI_API_KEY=AIza...
GOOGLE_AI_DEFAULT_MODEL=gemini-2.0-flash

# AWS Bedrock
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Ollama (온프레미스 오픈소스 LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Embedding
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai            # openai | local | huggingface
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=                  # 로컬 임베딩 서버 URL (비워두면 OpenAI 사용)
EMBEDDING_API_KEY=                   # 로컬 서버 키 (필요한 경우)

# -----------------------------------------------------------------------------
# Storage Connectors
# -----------------------------------------------------------------------------

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_EVENT_QUEUE_URL=              # SQS 큐 URL (이벤트 수신용)

# GCP Storage
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=            # JSON 문자열 또는 파일 경로
GCP_PUBSUB_SUBSCRIPTION=             # Pub/Sub 구독 이름

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_EVENT_GRID_ENDPOINT=
AZURE_EVENT_GRID_KEY=

# Naver Cloud Object Storage
NAVER_CLOUD_ACCESS_KEY=
NAVER_CLOUD_SECRET_KEY=
NAVER_CLOUD_REGION=kr-standard

# KT Cloud Object Storage
KT_CLOUD_ACCESS_KEY=
KT_CLOUD_SECRET_KEY=

# -----------------------------------------------------------------------------
# Indexing Pipeline
# -----------------------------------------------------------------------------
INDEXING_PRIORITY_HIGH_THRESHOLD=0.7
INDEXING_PRIORITY_LOW_THRESHOLD=0.3
INDEXING_BATCH_INTERVAL_MINUTES=60
INDEXING_MAX_CHUNK_SIZE=1000         # 토큰 단위
INDEXING_CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Agent (스토리지 로컬 에이전트)
# -----------------------------------------------------------------------------
AGENT_PORT=8080
AGENT_SECRET=change-me-agent-secret  # 에이전트-백엔드 간 인증
AGENT_BASE_URL=http://agent:8080     # docker-compose 내부 URL
AGENT_HEARTBEAT_INTERVAL_SECONDS=30

# Local filesystem watch path (on-premise dev)
LOCAL_WATCH_PATH=/tmp/docmonauto-watch

# Embedding (Python agent)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=cpu                 # cpu | cuda | mps

# -----------------------------------------------------------------------------
# Ops / Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL=info                       # debug | info | warn | error
LOG_FORMAT=json                      # json | pretty

# 헬스체크
HEALTH_CHECK_TIMEOUT_MS=5000
