# =============================================================================
# DocMonAuto — Environment Variables Template
# Copy this file to .env and fill in values. Never commit .env to version control.
# =============================================================================
#
# -----------------------------------------------------------------------------
# 실행 방식 (두 가지) — 값 충돌 방지
# -----------------------------------------------------------------------------
#
# (1) 컴포넌트 디렉터리에서 직접 실행 (로컬 개발)
#     - 이 파일을 복사한 루트 `.env`를 기준으로 동작합니다.
#     - 권장: 아래 "로컬용" 주석이 붙은 값 사용
#       • AGENT_BASE_URL=http://localhost:8080  (백엔드가 호스트에서 에이전트 호출)
#       • BACKEND_URL(에이전트): http://localhost:3001
#       • DATABASE_URL: localhost, REDIS_HOST: localhost
#
# (2) ops/docker compose up -d (전체 스택)
#     - compose 파일의 `services.*.environment` 항목이 동일 이름 변수를 덮어씁니다.
#       루트 `.env`에 (1)용 값이 있어도 컨테이너에는 적용되지 않습니다.
#     - 예: backend → AGENT_BASE_URL=http://agent:8080
#           agent → DATABASE_URL=...@postgres:5432/..., BACKEND_URL=http://backend:3001
#     - 따라서 (1)에서 검증한 뒤 `.env`를 (2)용으로 바꿀 필요가 없습니다.
#
# database 패키지 시드: `database/prisma/seed.ts`는 루트 `.env` 후 `database/.env`를
# 읽으며, 후자가 같은 키에서 우선합니다.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                  # development | staging | production
APP_PORT=3001
APP_SECRET=change-me-32-chars-minimum-here!
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend (Next.js — 브라우저에서 접근하는 호스트 URL로 설정)
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
# API 베이스 (동일 기기: 백엔드 기본 포트 3001)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=DocMonAuto

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# DATABASE_PASSWORD는 반드시 DATABASE_URL 안의 비밀번호와 동일해야 합니다.
# 시드(prisma/seed.ts)는 DATABASE_PASSWORD가 있으면 호스트/포트/유저와 맞춰 DATABASE_URL을 덮어씁니다.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://docmonauto:change-me-db-password@localhost:5432/docmonauto
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=docmonauto
DATABASE_USER=docmonauto
DATABASE_PASSWORD=change-me-db-password

# -----------------------------------------------------------------------------
# Redis (메시지 큐, 캐시)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_AI_API_KEY=AIza...
GOOGLE_AI_DEFAULT_MODEL=gemini-2.0-flash

# AWS Bedrock
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Ollama (온프레미스 오픈소스 LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Embedding
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai            # openai | local | huggingface
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=                  # 로컬 임베딩 서버 URL (비워두면 OpenAI 사용)
EMBEDDING_API_KEY=                   # 로컬 서버 키 (필요한 경우)

# -----------------------------------------------------------------------------
# Storage Connectors
# -----------------------------------------------------------------------------

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_EVENT_QUEUE_URL=              # SQS 큐 URL (이벤트 수신용)

# GCP Storage
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=            # JSON 문자열 또는 파일 경로
GCP_PUBSUB_SUBSCRIPTION=             # Pub/Sub 구독 이름

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_EVENT_GRID_ENDPOINT=
AZURE_EVENT_GRID_KEY=

# Naver Cloud Object Storage
NAVER_CLOUD_ACCESS_KEY=
NAVER_CLOUD_SECRET_KEY=
NAVER_CLOUD_REGION=kr-standard

# KT Cloud Object Storage
KT_CLOUD_ACCESS_KEY=
KT_CLOUD_SECRET_KEY=

# -----------------------------------------------------------------------------
# Indexing Pipeline
# -----------------------------------------------------------------------------
INDEXING_PRIORITY_HIGH_THRESHOLD=0.7
INDEXING_PRIORITY_LOW_THRESHOLD=0.3
INDEXING_BATCH_INTERVAL_MINUTES=60
INDEXING_MAX_CHUNK_SIZE=1000         # 토큰 단위
INDEXING_CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Agent (스토리지 로컬 에이전트)
# -----------------------------------------------------------------------------
AGENT_PORT=8080
AGENT_SECRET=change-me-agent-secret  # 에이전트-백엔드 간 인증
# 로컬 백엔드 실행 시 에이전트 호출 주소 (Compose의 backend 서비스는 이 값을 environment에서 재정의)
AGENT_BASE_URL=http://localhost:8080
# 에이전트가 Nest API 를 부를 주소 — 로컬: localhost (Compose agent 서비스는 environment에서 backend:3001 로 설정)
BACKEND_URL=http://localhost:3001
AGENT_HEARTBEAT_INTERVAL_SECONDS=30

# Local filesystem watch path (on-premise dev)
LOCAL_WATCH_PATH=/tmp/docmonauto-watch

# Embedding (Python agent)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=cpu                 # cpu | cuda | mps

# -----------------------------------------------------------------------------
# Ops / Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL=info                       # debug | info | warn | error
LOG_FORMAT=json                      # json | pretty

# 헬스체크
HEALTH_CHECK_TIMEOUT_MS=5000
