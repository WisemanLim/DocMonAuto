#!/usr/bin/env bash
# Ensures Compose loads project root .env (variable substitution + services).
set -euo pipefail
cd "$(dirname "$0")"
ROOT_ENV="../.env"
if [[ ! -f "$ROOT_ENV" ]]; then
  echo "Missing $ROOT_ENV — run: cp .env.example .env (from repo root)" >&2
  exit 1
fi
if [[ ! -f .env ]]; then
  ln -sf "$ROOT_ENV" .env
fi
exec docker compose "$@"
